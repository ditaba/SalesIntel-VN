# Secret used to sign session cookies (REQUIRED in production)
AUTH_SECRET=change-me-to-a-long-random-string
# Optional: enables Claude-powered narratives and natural-language query parsing.
# Without it, the deterministic rules engine is used for all AI features.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
AI_MODEL=claude-opus-5-5
# SQLite database path (default ./data/salesintel.db). Auto-created and seeded on first request.
DATABASE_PATH=./data/salesintel.db
